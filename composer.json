{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "waadby/operations-agent",
    "description": "Reusable local operations agent for WAADBY Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "lcobucci/jwt": "^5.6",
        "symfony/process": "^7.3",
        "symfony/finder": "^7.3",
        "web-token/jwt-library": "^4.1"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "Waadby\\OperationsAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format:check": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Waadby\\OperationsAgent\\OperationsAgentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
